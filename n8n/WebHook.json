    {
      "parameters": {
        "jsCode": "const firebaseData = $json;\nif (!firebaseData || typeof firebaseData !== 'object') {\n  return [];\n}\n\nconst keys = Object.keys(firebaseData);\n\nif (keys.length > 30) {\n  const sorted = keys.sort((a, b) => {\n    const dateA = new Date(firebaseData[a].timestamp);\n    const dateB = new Date(firebaseData[b].timestamp);\n    return dateA - dateB;\n  });\n\n  const oldestKey = sorted[0];\n  const secondKey = sorted[1];\n  const thirdKey = sorted[2]\n  \n  return [{ json: { keyToDelete: oldestKey,\n                    secondKeyToDelete: secondKey,\n                    thirdKeyToDelete: thirdKey,\n                  cuisine: $('transformation').first().json.cuisine\n                  } }];\n}\n\nreturn [];"
      },
