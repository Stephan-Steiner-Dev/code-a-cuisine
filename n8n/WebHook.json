    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers || {};\n\n// Produktion (Proxy-Header)\nconst xff = headers[\"x-forwarded-for\"];\nconst cfip = headers[\"cf-connecting-ip\"];\nconst xri = headers[\"x-real-ip\"];\n\n// NUR LOCAL TESTING (später entfernen)\nconst xClientIp = headers[\"x-client-ip\"];\n\nlet ipRaw =\n  (cfip && String(cfip).trim()) ||\n  (xri && String(xri).trim()) ||\n  (xff && String(xff).split(\",\")[0].trim()) ||\n  (xClientIp && String(xClientIp).trim()) ||\n  \"\";\n\nif (ipRaw.startsWith(\"::ffff:\")) ipRaw = ipRaw.replace(\"::ffff:\", \"\");\n\n// Firebase-sicherer Key\nconst ipKey = ipRaw.toLowerCase().trim().replaceAll(\".\", \"_\").replaceAll(\":\", \"_\");\n\n// Datum Europe/Berlin -> YYYY-MM-DD\nconst nowBerlin = new Date(\n  new Date().toLocaleString(\"en-US\", { timeZone: \"Europe/Berlin\" })\n);\nconst yyyy = nowBerlin.getFullYear();\nconst mm = String(nowBerlin.getMonth() + 1).padStart(2, \"0\");\nconst dd = String(nowBerlin.getDate()).padStart(2, \"0\");\nconst dateKey = `${yyyy}-${mm}-${dd}`;\n\nreturn [{\n  json: {\n    ...item,\n    _quota: {\n      ip: ipRaw,\n      ipKey,\n      dateKey,\n      original: item, // <--- wichtig\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2144,
        336
      ],
      "id": "2397347a-90cb-4823-adc3-3ccc2866834d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Firebase REST Antwort steht bei dir in item.data (wie du gesehen hast)\nconst raw = item.data;\n\nlet ipCount = 0;\nif (raw === null || raw === undefined || raw === \"\" || raw === \"null\") {\n  ipCount = 0;\n} else {\n  ipCount = Number(raw) || 0;\n}\n\nreturn [{\n  json: {\n    ...item,\n    _quota: {\n      ...(item._quota || {}),\n      ipCount\n    }\n  }\n}];\n"
      },
